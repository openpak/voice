# Voice (block 20160 in ports.md). Copy to the deploy env file; secrets as files.
VOICE_HTTP_ADDR=0.0.0.0:20160
VOICE_GRPC_ADDR=0.0.0.0:20161
# The account core's gRPC and the credential this service presents there.
VOICE_CORE_ADDRESS=openpak-account:20001
VOICE_CORE_INTERNAL_KEY_FILE=/run/voice/core.key
# One key per adapter, "namespace=key" per line or comma separated (keys >= 16
# characters). The key names the adapter: xbox, app, ...
VOICE_ADAPTER_KEYS_FILE=/run/voice/adapters.keys
